<body>

<!-- Star icon sprite: reused by every review via <use href="#icon-star"> -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="icon-star" viewBox="0 0 24 24">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
  </symbol>
</svg>

<!-- ===== Sticky header with theme toggle ===== -->
<header class="masthead">
    <span class="masthead__brand">Gabryan's portfolio <span style='font-size: 1rem'>💼</span> &nbsp;/&nbsp;</span>

  <div class="masthead__right">
    <nav aria-label="Primary">
      <a href="#about">About</a>
      <a href="#clients">Clients</a>
      <a href="#work">Work</a>
    </nav>

    <!-- role="switch": aria-checked="true" means dark mode is ON -->
    <button class="switch" id="themeToggle" type="button" role="switch"
            aria-checked="true" aria-label="Dark mode">
      <span class="switch__knob" aria-hidden="true"></span>
    </button>
  </div>
</header>

<main>
  <!-- ===== HERO: two-column split ===== -->
  <section class="hero" id="about">

    <!-- LEFT: headline, bio, button -->
