            <svg class="star" aria-hidden="true"><use href="#icon-star"/></svg>
            <svg class="star" aria-hidden="true"><use href="#icon-star"/></svg>
            <svg class="star" aria-hidden="true"><use href="#icon-star"/></svg>
            <svg class="star" aria-hidden="true"><use href="#icon-star"/></svg>
          </div>
        </figure>
