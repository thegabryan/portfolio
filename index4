<!-- Enables large image preview format in Discord and Twitter/X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#00aaff" />

<!-- JavaScript
  Apply the saved theme BEFORE first paint so there is no flash.
  Default is dark; only an explicit "light" choice overrides it.

  THEME TOGGLE
  Flips data-theme on <html> between "dark" and "light",
  keeps the switch's aria-checked in sync, and remembers the
  choice (storage wrapped in try/catch for private windows).
========================================================== -->
<script src="script.js" defer></script>

<!-- Fonts: serif headlines + heavy slab/sans labels -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,500&family=Roboto+Slab:wght@400;700;900&family=Archivo+Black&display=swap" rel="stylesheet">

<link rel="stylesheet" href="style.css">
